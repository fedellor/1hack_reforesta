# Base de datos (Por defecto usa SQLite en modo WAL de alto rendimiento en ./data/reforesta.db)
# Para usar Supabase / Neon PostgreSQL en la nube, pon tu connection string:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./data/reforesta.db

# Estrategia Multi-Proveedor de IA para la Capa 2 (Cero dependencia obligatoria):
# 1. Si configuras GEMINI_API_KEY (o GROQ_API_KEY / OPENROUTER_API_KEY) en el servidor de producción,
#    ningún usuario necesita clave propia.
# 2. Si ENABLE_PUBLIC_LLM_FALLBACK=true, puede consultar un endpoint público sin API key.
# 3. Si todas están vacías, el Motor Experto Determinista Local (Tier 4) evalúa en <1ms sin depender de APIs externas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-preview-02-05:free
ENABLE_PUBLIC_LLM_FALLBACK=false

# Base de Datos Viva & Rendimiento (Histórico profundo desde 2016 sin tope superior rígido)
INGEST_START_YEAR=2016
INGEST_END_YEAR=2028
INGEST_CONCURRENCY=12
LAYER1_THRESHOLD=25
INCLUDE_CATALOG_TEMPLATES=false

# Sincronización diaria automática a las 07:00 Europe/Madrid
AUTO_SYNC_ENABLED=true
DAILY_SYNC_HOUR=7
DAILY_SYNC_MINUTE=0
DAILY_SYNC_TIMEZONE=Europe/Madrid
AUTO_SYNC_INTERVAL_MINUTES=1440
# Al arrancar (p. ej. al levantar Docker), sincroniza si se perdió la última cita de las 07:00
SYNC_CATCHUP_ON_STARTUP=true
# Reintentos si una sincronización falla por una excepción
SYNC_RETRY_ATTEMPTS=3
SYNC_RETRY_DELAY_SECONDS=300
CACHE_TTL_SECONDS=60
PUBLIC_BACKEND_URL=http://localhost:8000
